# FastAPI + Socket.IO server URL. For local development on the same computer:
VITE_API_BASE_URL=http://localhost:5001
VITE_SOCKET_URL=http://localhost:5001

# For a phone testing over Wi-Fi, replace localhost with your development PC's LAN IP,
# e.g. http://192.168.1.10:5001 (and allow the ports through your firewall).
